      name="twitter:description"
      content="Create a professional portfolio website with Code5in and build your professional online presence."
    />
    <!-- twitter:image — Add your social sharing image URL below when available -->
    <!-- <meta name="twitter:image" content="https://code5in.site/og-image.png" /> -->
