  <body>
    <!-- Loading Screen -->
    <div class="loading-screen" id="loadingScreen">
      <div class="loader-content">
        <div class="loader-logo">
          <span class="loader-code">Code</span><span class="loader-five">5</span
          ><span class="loader-in">in</span>
        </div>
        <div class="loader-bar">
          <div class="loader-bar-fill"></div>
        </div>
        <p class="loader-text">Loading Premium Experience...</p>
      </div>
