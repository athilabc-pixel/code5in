    <title>Code5in | Professional Portfolio Website Design</title>
    <meta
      name="description"
      content="Create a professional portfolio website with Code5in. Showcase your skills, experience, projects, achievements and services with a modern responsive portfolio website."
    />
    <meta
      name="keywords"
      content="portfolio website, portfolio templates, Code5in, premium portfolios, professional website, freelancer portfolio, doctor portfolio, lawyer portfolio, architect portfolio, business website"
    />
    <meta name="author" content="Code5in" />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <link rel="canonical" href="https://code5in.site/" />
    <!-- Open Graph Meta Tags -->
    <meta property="og:type" content="website" />
