      property="og:title"
      content="Code5in | Professional Portfolio Website Design"
    />
    <meta
      property="og:description"
      content="Create a professional portfolio website to showcase your skills, experience, projects, achievements and services."
    />
    <meta property="og:url" content="https://code5in.site/" />
    <meta property="og:site_name" content="Code5in" />
    <!-- og:image — Add your social sharing image URL below when available -->
    <!-- <meta property="og:image" content="https://code5in.site/og-image.png" /> -->
