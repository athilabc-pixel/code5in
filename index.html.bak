    <!-- Scroll Progress Bar -->
    <div class="scroll-progress" id="scrollProgress"></div>

    <!-- Custom Cursor -->
    <div class="cursor-dot" id="cursorDot"></div>
    <div class="cursor-ring" id="cursorRing"></div>

    <!-- Navigation -->
    <header>
      <nav class="navbar" id="navbar" aria-label="Main navigation">
        <div class="nav-container">
