    <main>
      <!-- Hero Section -->
      <section class="hero" id="home">
        <canvas class="hero-particles" id="heroParticles"></canvas>
        <div class="hero-grid-bg"></div>
        <div class="hero-gradient-blob blob-1"></div>
        <div class="hero-gradient-blob blob-2"></div>
        <div class="hero-gradient-blob blob-3"></div>
        <div class="hero-floating-shapes">
          <div class="floating-shape shape-1"></div>
          <div class="floating-shape shape-2"></div>
          <div class="floating-shape shape-3"></div>
          <div class="floating-shape shape-4"></div>
          <div class="floating-shape shape-5"></div>
        </div>
        <div class="hero-content">
          <div class="hero-badge fade-up">
            <span class="badge-dot"></span>
            <span>Premium Portfolio Agency</span>
          </div>
          <h1 class="hero-headline">
            <span class="headline-word">PROFESSIONAL</span>
            <span class="headline-word">PORTFOLIO</span>
            <span class="headline-word">WEBSITES</span>
            <span class="headline-word headline-accent">FOR EVERY</span>
            <span class="headline-word headline-accent2 hero-typewriter-wrap"
              ><span id="heroTypedText">PROFESSION.</span
              ><span class="hero-cursor">|</span></span
            >
          </h1>
          <p class="hero-subheading fade-up">
            Explore professionally designed portfolio websites built for modern
            professionals and businesses. 20+ premium templates crafted by
            Code5in.
          </p>
          <div class="hero-buttons fade-up">
            <a href="#templates" class="btn btn-primary">
              <span>Explore Templates</span>
              <i class="fas fa-arrow-right"></i>
            </a>
            <a href="#contact" class="btn btn-secondary">
              <span>Get Custom Website</span>
              <i class="fas fa-sparkles"></i>
            </a>
            <button
              class="hero-share-btn"
              id="heroShareBtn"
              aria-label="Share Website"
              title="Share Website"
            >
              <i class="fas fa-share-nodes"></i>
            </button>
          </div>
          <div class="hero-stats fade-up">
            <div class="hero-stat">
              <span class="hero-stat-number">20+</span>
              <span class="hero-stat-label">Templates</span>
            </div>
            <div class="hero-stat-divider"></div>
            <div class="hero-stat">
              <span class="hero-stat-number">150+</span>
              <span class="hero-stat-label">Projects</span>
            </div>
            <div class="hero-stat-divider"></div>
            <div class="hero-stat">
              <span class="hero-stat-number">99%</span>
              <span class="hero-stat-label">Satisfaction</span>
            </div>
          </div>
        </div>
        <div class="hero-scroll-indicator">
          <div class="scroll-mouse">
            <div class="scroll-wheel"></div>
          </div>
          <span>Scroll to explore</span>
        </div>
      </section>

      <!-- Why You Need A Portfolio Section -->
      <section class="why-portfolio-section" id="why-portfolio">
        <div class="why-portfolio-bg-glow"></div>
        <div class="container">
          <div class="section-header fade-up">
            <span class="section-tag"
              ><i class="fas fa-sparkles"></i> Value & Impact</span
            >
            <h2 class="section-title">
              Why You Need a <span class="gradient-text">Portfolio</span>
            </h2>
            <p class="section-subtitle">
              In today's digital age, your portfolio is your resume. Make it
              count with a design that reflects your excellence.
            </p>
          </div>

          <div class="why-portfolio-grid stagger-container">
            <div
              class="why-portfolio-card stagger-item"
              data-tilt
              data-tilt-max="6"
              data-tilt-speed="400"
            >
              <div class="why-card-shine"></div>
              <div class="why-card-top">
                <div class="why-card-icon icon-glow-purple">
                  <i class="fas fa-shield-halved"></i>
                </div>
                <span class="why-card-num">01</span>
              </div>
              <h3>First Impression & Trust</h3>
              <p>
                A professional website builds instant credibility and sets you
                apart from competitors before clients even speak to you.
              </p>
              <div class="why-card-badge">Instant Trust ⚡</div>
            </div>

            <div
              class="why-portfolio-card stagger-item"
              data-tilt
              data-tilt-max="6"
              data-tilt-speed="400"
            >
              <div class="why-card-shine"></div>
              <div class="why-card-top">
                <div class="why-card-icon icon-glow-cyan">
                  <i class="fas fa-bullseye"></i>
                </div>
                <span class="why-card-num">02</span>
              </div>
              <h3>Showcase Real Results</h3>
              <p>
                Highlight your best projects, case studies, client testimonials,
                and skills with high-visual impact layouts.
              </p>
              <div class="why-card-badge">High Impact 📈</div>
            </div>

            <div
              class="why-portfolio-card stagger-item"
              data-tilt
              data-tilt-max="6"
              data-tilt-speed="400"
            >
              <div class="why-card-shine"></div>
              <div class="why-card-top">
                <div class="why-card-icon icon-glow-green">
                  <i class="fas fa-chart-line"></i>
                </div>
                <span class="why-card-num">03</span>
              </div>
              <h3>24/7 Digital Presence</h3>
              <p>
                Your portfolio works for you around the clock, attracting leads,
                clients, and career opportunities automatically.
              </p>
              <div class="why-card-badge">Auto Leads 🚀</div>
            </div>

            <div
              class="why-portfolio-card stagger-item"
              data-tilt
              data-tilt-max="6"
              data-tilt-speed="400"
            >
              <div class="why-card-shine"></div>
              <div class="why-card-top">
                <div class="why-card-icon icon-glow-amber">
                  <i class="fas fa-gem"></i>
                </div>
                <span class="why-card-num">04</span>
              </div>
              <h3>Higher Pricing & Value</h3>
              <p>
                Command higher rates for your services by presenting your work
                in a high-end, agency-level digital showcase.
              </p>
              <div class="why-card-badge">3x Client Value 💎</div>
            </div>
          </div>
        </div>
      </section>

      <!-- Templates Section -->
      <section class="templates-section" id="templates">
        <div class="container">
          <div class="section-header fade-up">
            <span class="section-tag">Our Templates</span>
            <h2 class="section-title">
              Premium Portfolio <span class="gradient-text">Templates</span>
            </h2>
            <p class="section-subtitle">
              Handcrafted portfolio websites designed for every profession. Each
              template is fully customizable and optimized for performance.
            </p>
            <div class="currency-toggle-wrapper">
              <div
                class="currency-tip"
                id="currencyTip"
                role="status"
                aria-hidden="true"
              >
                <button
                  type="button"
                  class="currency-tip-close"
                  id="currencyTipClose"
                  aria-label="Dismiss currency notification"
                >
                  &times;
                </button>
                <strong>💰 Select your currency</strong>
                <span>Choose ₹ INR or $ USD to view prices.</span>
              </div>
              <div
                class="currency-toggle"
                data-active-currency="INR"
                role="group"
                aria-label="Currency Switcher"
              >
                <button
                  type="button"
                  class="currency-btn active"
                  data-currency="INR"
                  aria-pressed="true"
                >
                  <span class="currency-flag">₹</span>
                  <span class="currency-text">INR</span>
                </button>
                <button
                  type="button"
                  class="currency-btn"
                  data-currency="USD"
                  aria-pressed="false"
                >
                  <span class="currency-flag">$</span>
                  <span class="currency-text">USD</span>
                </button>
              </div>
            </div>
          </div>

          <!-- Filter & Search -->
          <div class="templates-controls fade-up">
            <div class="filter-pills" id="filterPills">
              <button class="filter-pill active" data-filter="all">All</button>
              <button class="filter-pill" data-filter="business">
                Business
              </button>
              <button class="filter-pill" data-filter="finance">Finance</button>
              <button class="filter-pill" data-filter="healthcare">
                Healthcare
              </button>
              <button class="filter-pill" data-filter="creative">
                Creative
              </button>
              <button class="filter-pill" data-filter="professional">
                Professional
              </button>
              <button class="filter-pill" data-filter="multipurpose">
                Multi Purpose
              </button>
            </div>
            <div class="search-box">
              <i class="fas fa-search search-icon"></i>
              <input
                type="text"
                class="search-input"
                id="templateSearch"
                placeholder="Search templates..."
                autocomplete="off"
              />
            </div>
          </div>

          <!-- Templates Grid -->
          <div class="templates-grid" id="templatesGrid">
            <!-- Dynamically populated by JavaScript -->
          </div>

          <!-- Show More Button -->
          <div class="show-more-wrapper fade-up" id="showMoreWrapper">
            <button class="btn btn-show-more" id="showMoreBtn">
              <span>Show More Templates</span>
              <i class="fas fa-chevron-down"></i>
            </button>
          </div>

          <div class="template-download-section fade-up">
            <div class="section-header">
              <h2 class="section-title">
                All Templates – Full Details &amp; Download
              </h2>
              <p class="section-subtitle">
                Download the complete pricing and template details in USD or
                INR.
              </p>
            </div>
            <div class="template-card template-download-card">
              <div class="card-shine"></div>
              <div class="card-body">
                <h3 class="template-name">Complete Template Details</h3>
                <p class="template-profession">All 20 Templates</p>
                <p class="template-style">
                  View all 20 templates, professions, previous prices, current
                  prices, and offer percentages in the complete pricing
                  documents.
                </p>
              </div>
              <div class="card-footer template-download-actions">
                <a
                  href="./analays%20dollar.pdf"
                  class="btn-preview"
                  download="analays dollar.pdf"
                  >Download in USD</a
                >
                <a
                  href="./analays%20ruppee.pdf"
                  class="btn-details"
                  download="analays rupee.pdf"
                  >Download in INR</a
                >
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Customization Section -->
      <section class="customization-section" id="customization">
        <div class="container">
          <div class="custom-wrapper">
            <div class="custom-content fade-left">
              <span class="section-tag">Customization</span>
              <h2 class="section-title">
                Need A Custom <span class="gradient-text">Portfolio?</span>
              </h2>
              <p class="custom-text">
                Every portfolio can be fully customized and rebuilt for your
                profession, business, personal brand, or company requirements.
                Our team delivers tailor-made solutions that perfectly represent
                your unique identity.
              </p>
              <a href="#contact" class="btn btn-primary">
                <span>Request Custom Portfolio</span>
                <i class="fas fa-arrow-right"></i>
              </a>
            </div>
            <div class="custom-features fade-right">
              <div class="custom-feature-card">
                <div class="feature-icon"><i class="fas fa-palette"></i></div>
                <div class="feature-info">
                  <h4>Custom Design</h4>
                  <p>Unique layouts tailored to your brand identity</p>
                </div>
              </div>
              <div class="custom-feature-card">
                <div class="feature-icon">
                  <i class="fas fa-fingerprint"></i>
                </div>
                <div class="feature-info">
                  <h4>Custom Branding</h4>
                  <p>Logo, colors, and typography matched to you</p>
                </div>
              </div>
              <div class="custom-feature-card">
                <div class="feature-icon">
                  <i class="fas fa-layer-group"></i>
                </div>
                <div class="feature-info">
                  <h4>Extra Pages</h4>
                  <p>Add as many pages as your project needs</p>
                </div>
              </div>
              <div class="custom-feature-card">
                <div class="feature-icon">
                  <i class="fas fa-wand-magic-sparkles"></i>
                </div>
                <div class="feature-info">
                  <h4>Advanced Animations</h4>
                  <p>Premium GSAP-powered interactions</p>
                </div>
              </div>
              <div class="custom-feature-card">
                <div class="feature-icon"><i class="fas fa-plug"></i></div>
                <div class="feature-info">
                  <h4>Custom Integrations</h4>
                  <p>APIs, forms, analytics, and third-party tools</p>
                </div>
              </div>
              <div class="custom-feature-card">
                <div class="feature-icon"><i class="fas fa-shapes"></i></div>
                <div class="feature-info">
                  <h4>Unique Layouts</h4>
                  <p>One-of-a-kind designs built from scratch</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Workflow Section -->
      <section class="workflow-section" id="workflow">
        <div class="container">
          <div class="section-header fade-up">
            <span class="section-tag">Our Workflow</span>
            <h2 class="section-title">
              How It Works —
              <span class="gradient-text">Simple & Fast</span> Process
            </h2>
            <p class="section-subtitle">
              Get your professional portfolio website ready in 5 easy steps.
            </p>
          </div>
          <div class="workflow-timeline" id="workflowTimeline">
            <div class="workflow-line"></div>
            <div class="workflow-progress-line" id="workflowProgressLine"></div>

            <div class="workflow-step" data-step="1">
              <div class="step-content text-right step-card-left">
                <span class="step-number-tag">01.</span>
                <h3>Choose Design</h3>
                <p>
                  Browse our premium template library and select the aesthetic
                  that best represents your personal brand and career goals.
                </p>
              </div>
              <div class="step-badge">1</div>
              <div class="step-empty"></div>
            </div>

            <div class="workflow-step" data-step="2">
              <div class="step-empty"></div>
              <div class="step-badge">2</div>
              <div class="step-content text-left step-card-right">
                <span class="step-number-tag">02.</span>
                <h3>Send Content</h3>
                <p>
                  Share your resume, project screenshots, and personal bio. We
                  handle all the formatting and organization for maximum impact.
                </p>
              </div>
            </div>

            <div class="workflow-step" data-step="3">
              <div class="step-content text-right step-card-left">
                <span class="step-number-tag">03.</span>
                <h3>Development</h3>
                <p>
                  Our expert developers build your site with clean, semantic
                  code, ensuring it's fast, responsive, and SEO-friendly.
                </p>
              </div>
              <div class="step-badge">3</div>
              <div class="step-empty"></div>
            </div>

            <div class="workflow-step" data-step="4">
              <div class="step-empty"></div>
              <div class="step-badge">4</div>
              <div class="step-content text-left step-card-right">
                <span class="step-number-tag">04.</span>
                <h3>Review & Refine</h3>
                <p>
                  Preview your live draft, request edits or custom enhancements,
                  and refine all details until your portfolio is 100% perfect.
                </p>
              </div>
            </div>

            <div class="workflow-step" data-step="5">
              <div class="step-content text-right step-card-left">
                <span class="step-number-tag">05.</span>
                <h3>Go Live</h3>
                <p>
                  We launch your website on your custom domain with fast
                  hosting, SSL security, and full search engine optimization.
                </p>
              </div>
              <div class="step-badge">5</div>
              <div class="step-empty"></div>
            </div>
          </div>
        </div>
      </section>

      <!-- About Us Section -->
      <section class="about-section" id="about">
        <div class="about-bg-glow"></div>
        <div class="container">
          <div class="about-grid">
            <!-- Left: Agency Story & Mission -->
            <div class="about-content fade-left">
              <span class="section-tag"
                ><i class="fas fa-sparkles"></i> About Code5in</span
              >
              <h2 class="section-title">
                Crafting Digital Excellence For
                <span class="gradient-text">Every Profession</span>
              </h2>
              <p class="about-description">
                Code5in is a premium web development studio specializing in
                high-performance portfolio websites. We empower freelancers,
                creators, doctors, lawyers, and entrepreneurs with stunning
                digital identities that convert visitors into clients.
              </p>

              <div class="about-highlights">
                <div class="about-highlight-item">
                  <div class="highlight-icon"><i class="fas fa-check"></i></div>
                  <span>Handcrafted Designs — Zero Generic Templates</span>
                </div>
                <div class="about-highlight-item">
                  <div class="highlight-icon"><i class="fas fa-check"></i></div>
                  <span>Ultra-Fast Loading & Modern Animations</span>
                </div>
                <div class="about-highlight-item">
                  <div class="highlight-icon"><i class="fas fa-check"></i></div>
                  <span>Fully Customized to Your Personal Brand</span>
                </div>
              </div>

              <a
                href="https://wa.me/919747506274?text=Hi%20Code5in,%20I'd%20like%20to%20learn%20more%20about%20your%20services"
                class="btn btn-primary"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>Get In Touch</span>
                <i class="fab fa-whatsapp"></i>
              </a>
            </div>

