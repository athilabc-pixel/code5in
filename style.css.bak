/* ==========================================================================
   CODE5IN — Premium Portfolio Marketplace
   Complete Production-Ready Stylesheet
   ========================================================================== */

/* ─── CSS Custom Properties ─── */
:root {
  --bg: #080a12;
  --bg-secondary: #101624;
  --bg-tertiary: #161d30;
  --accent: #7c5cff;
  --accent2: #00d4ff;
  --accent3: #00ffa3;
  --text: #ffffff;
  --muted: #a0a8c0;
  --glass-bg: rgba(16, 22, 36, 0.65);
  --glass-border: rgba(255, 255, 255, 0.08);
  --glass-border-hover: rgba(124, 92, 255, 0.35);
  --gradient-accent: linear-gradient(135deg, var(--accent), var(--accent2));
  --gradient-accent2: linear-gradient(135deg, var(--accent2), var(--accent3));
  --gradient-multi: linear-gradient(
    90deg,
    var(--accent),
    var(--accent2),
    var(--accent3)
  );
  --font-body: "Inter", sans-serif;
  --font-heading: "Outfit", sans-serif;
  --container: 1200px;
  --section-py: 120px;
  --radius: 16px;
  --radius-sm: 10px;
  --radius-full: 50px;
  --ease: cubic-bezier(0.25, 1, 0.5, 1);
  --transition: 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  --transition-fast: 0.25s ease;
  --shadow-glow: 0 0 30px rgba(124, 92, 255, 0.25);
  --shadow-card: 0 8px 32px rgba(0, 0, 0, 0.3);
}

/* ─── Reset & Base ─── */
*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}
html {
  scroll-behavior: smooth;
  font-size: 16px;
}
body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-body);
  line-height: 1.7;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
body.no-scroll {
  overflow: hidden;
}
::selection {
  background: var(--accent);
  color: var(--text);
}
::-webkit-scrollbar {
  width: 8px;
}
::-webkit-scrollbar-track {
  background: var(--bg);
}
::-webkit-scrollbar-thumb {
  background: var(--bg-secondary);
  border-radius: 4px;
}
::-webkit-scrollbar-thumb:hover {
  background: var(--accent);
}
h1,
h2,
h3,
h4,
h5,
h6 {
  font-family: var(--font-heading);
  font-weight: 700;
  line-height: 1.15;
  color: var(--text);
}
p {
  color: var(--muted);
  margin-bottom: 1rem;
  line-height: 1.7;
}
a {
  color: inherit;
  text-decoration: none;
  transition: var(--transition);
}
ul,
ol {
  list-style: none;
}
img {
  max-width: 100%;
  height: auto;
  display: block;
}
button {
  font-family: inherit;
  cursor: pointer;
  border: none;
  outline: none;
}

/* ─── Container ─── */
.container {
  max-width: var(--container);
  margin: 0 auto;
  padding: 0 24px;
  width: 100%;
}
section {
  padding: var(--section-py) 0;
  position: relative;
  overflow: hidden;
}

/* ─── Utility Classes ─── */
.gradient-text {
  background: var(--gradient-accent);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.glass {
  background: var(--glass-bg);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius);
}

/* ─── Section Headers ─── */
.section-header {
  text-align: center;
  max-width: 700px;
  margin: 0 auto 60px;
}
.section-tag {
  display: inline-block;
  padding: 6px 18px;
  border-radius: var(--radius-full);
  background: rgba(124, 92, 255, 0.1);
  border: 1px solid rgba(124, 92, 255, 0.25);
  color: var(--accent);
  font-size: 0.85rem;
  font-weight: 600;
  letter-spacing: 0.5px;
  margin-bottom: 20px;
  text-transform: uppercase;
}
.section-title {
  font-size: clamp(2rem, 4vw, 3rem);
  margin-bottom: 16px;
}
.section-subtitle {
  font-size: 1.05rem;
  color: var(--muted);
  max-width: 600px;
  margin: 0 auto;
}

/* ─── Buttons ─── */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 14px 32px;
  border-radius: var(--radius-full);
  font-weight: 600;
  font-size: 1rem;
  border: none;
  cursor: pointer;
  transition: var(--transition);
  position: relative;
  overflow: hidden;
  text-decoration: none;
  z-index: 1;
}
.btn i {
  font-size: 0.9rem;
  transition: transform 0.3s ease;
}
.btn:hover i {
  transform: translateX(4px);
}

.btn-primary {
  background: var(--gradient-accent);
  color: var(--text);
  box-shadow: 0 4px 20px rgba(124, 92, 255, 0.35);
}
.btn-primary::before {
  content: "";
  position: absolute;
  inset: 0;
  background: var(--gradient-accent2);
  opacity: 0;
  z-index: -1;
  transition: opacity 0.4s ease;
  border-radius: inherit;
}
.btn-primary:hover::before {
  opacity: 1;
}
.btn-primary:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 30px rgba(0, 212, 255, 0.4);
}

.btn-secondary {
  background: transparent;
  color: var(--text);
  border: 1px solid var(--glass-border);
  backdrop-filter: blur(10px);
}
.btn-secondary:hover {
  border-color: var(--accent);
  background: rgba(124, 92, 255, 0.08);
  transform: translateY(-3px);
}

.btn-large {
  padding: 13px 26px;
  font-size: 0.95rem;
}

.btn-show-more {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 16px 40px;
  border-radius: var(--radius-full);
  font-weight: 600;
  font-size: 1rem;
  background: var(--gradient-accent);
  color: var(--text);
  border: none;
  cursor: pointer;
  transition: var(--transition);
  box-shadow: 0 4px 20px rgba(124, 92, 255, 0.3);
}
.btn-show-more:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 30px rgba(124, 92, 255, 0.5);
}
.btn-show-more i {
  transition: transform 0.3s ease;
}
.btn-show-more:hover i {
  transform: translateY(3px);
}
.show-more-wrapper {
  text-align: center;
  margin-top: 50px;
}

/* ─── Keyframes ─── */
@keyframes float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-20px);
  }
}
@keyframes floatSlow {
  0%,
  100% {
    transform: translateY(0) rotate(0deg);
  }
  50% {
    transform: translateY(-30px) rotate(5deg);
  }
}
@keyframes pulse {
  0% {
    box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.5);
  }
  70% {
    box-shadow: 0 0 0 15px rgba(37, 211, 102, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(37, 211, 102, 0);
  }
}
@keyframes pulseDot {
  0%,
  100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.5;
    transform: scale(1.5);
  }
}
@keyframes shine {
  0% {
    left: -100%;
  }
  100% {
    left: 200%;
  }
}
@keyframes gradient-shift {
  0% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0% 50%;
  }
}
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
@keyframes scrollWheel {
  0% {
    opacity: 1;
    transform: translateY(0);
  }
  100% {
    opacity: 0;
    transform: translateY(8px);
  }
}
@keyframes barFill {
  0% {
    width: 0;
  }
  100% {
    width: 100%;
  }
}
@keyframes checkmark {
  0% {
    stroke-dashoffset: 100;
  }
  100% {
    stroke-dashoffset: 0;
  }
}

/* ─── GSAP Animation Classes ─── */
.fade-up,
.fade-left,
.fade-right,
.scale-in {
  opacity: 0;
}

/* ============================================================
   1. LOADING SCREEN
   ============================================================ */
.loading-screen {
  position: fixed;
  inset: 0;
  background: var(--bg);
  z-index: 99999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.loader-content {
  text-align: center;
}
.loader-logo {
  font-family: var(--font-heading);
  font-size: 2.5rem;
  font-weight: 800;
  margin-bottom: 30px;
  letter-spacing: 1px;
}
.loader-code {
  color: var(--text);
}
.loader-five {
  color: var(--accent);
}
.loader-in {
  color: var(--accent2);
}
.loader-bar {
  width: 200px;
  height: 3px;
  background: var(--glass-border);
  border-radius: 10px;
  margin: 0 auto 16px;
  overflow: hidden;
}
.loader-bar-fill {
  width: 0;
  height: 100%;
  background: var(--gradient-accent);
  border-radius: 10px;
  animation: barFill 1.8s ease forwards;
}
.loader-text {
  color: var(--muted);
  font-size: 0.85rem;
  letter-spacing: 1px;
}

/* ============================================================
   2. SCROLL PROGRESS BAR
   ============================================================ */
.scroll-progress {
  position: fixed;
  top: 0;
  left: 0;
  width: 0%;
  height: 3px;
  background: var(--gradient-multi);
  background-size: 200% 100%;
  animation: gradient-shift 3s ease infinite;
  z-index: 99998;
  transition: width 0.1s linear;
}

/* ============================================================
   3. CUSTOM CURSOR
   ============================================================ */
.cursor-dot,
.cursor-ring {
  display: none;
}
@media (min-width: 1025px) {
  body {
    cursor: none;
  }
  .cursor-dot,
  .cursor-ring {
    display: block;
    position: fixed;
    top: 0;
    left: 0;
    border-radius: 50%;
    pointer-events: none;
    z-index: 999999;
    transition: none;
  }
  .cursor-dot {
    width: 8px;
    height: 8px;
    background: var(--accent);
    transform: translate(-50%, -50%);
  }
  .cursor-ring {
    width: 36px;
    height: 36px;
    border: 2px solid rgba(124, 92, 255, 0.4);
    transform: translate(-50%, -50%);
    transition:
      width 0.3s ease,
      height 0.3s ease,
      border-color 0.3s ease;
  }
  .cursor-ring.cursor-hover {
    width: 50px;
    height: 50px;
    border-color: var(--accent2);
  }
  .cursor-dot.cursor-hover {
    background: var(--accent2);
  }
}

/* ============================================================
   4. NAVIGATION
   ============================================================ */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 9990;
  padding: 20px 0;
  transition: var(--transition);
}
.navbar.scrolled {
  background: rgba(8, 10, 18, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--glass-border);
  padding: 12px 0;
}
.nav-container {
  max-width: var(--container);
  margin: 0 auto;
  padding: 0 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.nav-logo {
  font-family: var(--font-heading);
  font-size: 1.6rem;
  font-weight: 800;
  letter-spacing: 0.5px;
  z-index: 9991;
}
.logo-code {
  color: var(--text);
}
.logo-five {
  color: var(--accent);
}
.logo-in {
  color: var(--accent2);
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 36px;
}
.nav-link {
  color: var(--muted);
  font-size: 0.95rem;
  font-weight: 500;
  position: relative;
  padding: 4px 0;
}
.nav-link::after {
  content: "";
  position: absolute;
  bottom: -2px;
  left: 0;
  width: 0;
  height: 2px;
  background: var(--gradient-accent);
  transition: width 0.3s ease;
}
.nav-link:hover,
.nav-link.active {
  color: var(--text);
}
.nav-link:hover::after,
.nav-link.active::after {
  width: 100%;
}

.nav-num,
.mobile-nav-header,
.mobile-nav-cta-wrapper {
  display: none;
}

.nav-cta {
  padding: 10px 24px;
  background: var(--gradient-accent);
  border-radius: var(--radius-full);
  color: var(--text);
  font-weight: 600;
  font-size: 0.9rem;
  box-shadow: 0 4px 15px rgba(124, 92, 255, 0.3);
  transition: var(--transition);
}
.nav-cta:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 25px rgba(124, 92, 255, 0.45);
}

.nav-toggle {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 8px;
  z-index: 99999;
}
.toggle-line {
  display: block;
  width: 24px;
  height: 2px;
  background: var(--text);
  border-radius: 2px;
  transition: var(--transition);
}
.nav-toggle.active .toggle-line:nth-child(1) {
  transform: rotate(45deg) translate(5px, 5px);
}
.nav-toggle.active .toggle-line:nth-child(2) {
  opacity: 0;
}
.nav-toggle.active .toggle-line:nth-child(3) {
  transform: rotate(-45deg) translate(5px, -5px);
}

/* ============================================================
   5. HERO SECTION
   ============================================================ */
.hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  padding: 120px 24px 80px;
}
.hero-particles {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  opacity: 0.5;
}
.hero-grid-bg {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(124, 92, 255, 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(124, 92, 255, 0.03) 1px, transparent 1px);
  background-size: 60px 60px;
  z-index: 0;
}
.hero-gradient-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(100px);
  z-index: 0;
  opacity: 0.35;
}
.blob-1 {
  width: 500px;
  height: 500px;
  background: radial-gradient(circle, var(--accent), transparent);
  top: -10%;
  right: -5%;
  animation: floatSlow 8s ease-in-out infinite;
}
.blob-2 {
  width: 400px;
  height: 400px;
  background: radial-gradient(circle, var(--accent2), transparent);
  bottom: 10%;
  left: -8%;
  animation: floatSlow 10s ease-in-out infinite reverse;
}
.blob-3 {
  width: 300px;
  height: 300px;
  background: radial-gradient(circle, var(--accent3), transparent);
  top: 40%;
  right: 20%;
  animation: floatSlow 12s ease-in-out infinite;
}
.hero-floating-shapes {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
}
.floating-shape {
  position: absolute;
  border-radius: 50%;
  border: 1px solid var(--glass-border);
  background: rgba(124, 92, 255, 0.03);
}
.shape-1 {
  width: 80px;
  height: 80px;
  top: 15%;
  left: 10%;
  animation: float 6s ease-in-out infinite;
}
.shape-2 {
  width: 120px;
  height: 120px;
  top: 60%;
  right: 8%;
  animation: float 8s ease-in-out infinite 1s;
  border-radius: 30%;
}
.shape-3 {
  width: 60px;
  height: 60px;
  bottom: 20%;
  left: 25%;
  animation: float 7s ease-in-out infinite 0.5s;
}
.shape-4 {
  width: 40px;
  height: 40px;
  top: 25%;
  right: 30%;
  animation: float 5s ease-in-out infinite 2s;
}
.shape-5 {
  width: 100px;
  height: 100px;
  bottom: 30%;
  right: 15%;
  animation: float 9s ease-in-out infinite 1.5s;
  border-radius: 40%;
}

.hero-content {
  position: relative;
  z-index: 2;
  text-align: center;
  max-width: 900px;
  margin: 0 auto;
}
.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 20px;
  border-radius: var(--radius-full);
  background: rgba(124, 92, 255, 0.08);
  border: 1px solid rgba(124, 92, 255, 0.2);
  font-size: 0.85rem;
  color: var(--accent);
  font-weight: 500;
  margin-bottom: 32px;
}
.badge-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--accent);
  animation: pulseDot 2s ease-in-out infinite;
}
.hero-headline {
  font-family: var(--font-heading);
  font-size: clamp(2.5rem, 7vw, 5.5rem);
  font-weight: 900;
  line-height: 1.05;
  margin-bottom: 28px;
  letter-spacing: -1px;
}
.headline-word {
  display: block;
  color: var(--text);
}
.headline-accent {
  background: var(--gradient-accent);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.headline-accent2 {
  background: var(--gradient-accent2);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
/* ── Hero Typewriter Animation ── */
.hero-typewriter-wrap {
  display: block;
  min-width: 11ch; /* wide enough for "PROFESSION." — prevents layout jump */
}
.hero-cursor {
  display: inline;
  -webkit-text-fill-color: var(--accent2);
  animation: heroCursorBlink 0.7s step-end infinite;
  margin-left: 2px;
}
@keyframes heroCursorBlink {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0;
  }
}
.hero-subheading {
  font-size: clamp(1rem, 1.5vw, 1.2rem);
  color: var(--muted);
  max-width: 600px;
  margin: 0 auto 36px;
  line-height: 1.7;
}
.hero-buttons {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  flex-wrap: wrap;
  margin-bottom: 50px;
}
.hero-share-btn {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid var(--glass-border);
  color: var(--text);
  font-size: 1.1rem;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: var(--transition);
}
.hero-share-btn:hover {
  background: var(--accent);
  border-color: var(--accent);
  color: var(--text);
  transform: translateY(-3px);
  box-shadow: 0 6px 20px rgba(124, 92, 255, 0.45);
}

/* Share Toast */
.share-toast {
  position: fixed;
  bottom: 30px;
  left: 50%;
  transform: translateX(-50%) translateY(20px);
  background: rgba(16, 22, 36, 0.95);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid var(--accent);
  color: var(--text);
  padding: 12px 24px;
  border-radius: var(--radius-full);
  font-size: 0.9rem;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 10px;
  z-index: 999999;
  opacity: 0;
  transition: all 0.4s var(--ease);
  box-shadow: 0 8px 30px rgba(124, 92, 255, 0.35);
}
.share-toast.show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}
.share-toast i {
  color: var(--accent3);
}
.hero-stats {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40px;
  flex-wrap: wrap;
}
.hero-stat {
  text-align: center;
}
.hero-stat-number {
  display: block;
  font-family: var(--font-heading);
  font-size: 1.8rem;
  font-weight: 700;
  background: var(--gradient-accent);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.hero-stat-label {
  font-size: 0.85rem;
  color: var(--muted);
}
.hero-stat-divider {
  width: 1px;
  height: 40px;
  background: var(--glass-border);
}

.hero-scroll-indicator {
  position: absolute;
  bottom: 30px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  z-index: 2;
}
.scroll-mouse {
  width: 26px;
  height: 40px;
  border: 2px solid var(--glass-border);
  border-radius: 14px;
  position: relative;
}
.scroll-wheel {
  width: 4px;
  height: 8px;
  background: var(--accent);
  border-radius: 4px;
  position: absolute;
  top: 6px;
  left: 50%;
  transform: translateX(-50%);
  animation: scrollWheel 1.5s ease-in-out infinite;
}
.hero-scroll-indicator span {
  font-size: 0.7rem;
  color: var(--muted);
  letter-spacing: 1px;
  text-transform: uppercase;
}

/* ============================================================
   5B. WHY YOU NEED A PORTFOLIO SECTION (ULTRA PREMIUM)
   ============================================================ */
.why-portfolio-section {
  background: var(--bg-secondary);
  position: relative;
  overflow: hidden;
}

.why-portfolio-bg-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600px;
  height: 400px;
  background: radial-gradient(
    circle,
    rgba(124, 92, 255, 0.12) 0%,
    rgba(0, 212, 255, 0.06) 50%,
    transparent 70%
  );
  filter: blur(80px);
  pointer-events: none;
  z-index: 0;
}

.why-portfolio-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 28px;
  position: relative;
  z-index: 1;
}

.why-portfolio-card {
  background: rgba(16, 22, 36, 0.75);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: var(--radius);
  padding: 24px 20px 20px;
  transition: all 0.4s var(--ease);
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transform-style: preserve-3d;
}

.why-portfolio-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: var(--gradient-accent);
  opacity: 0;
  transition: opacity 0.4s ease;
}

.why-portfolio-card:hover {
  border-color: rgba(124, 92, 255, 0.4);
  transform: translateY(-6px) scale(1.015);
  box-shadow:
    0 16px 30px rgba(0, 0, 0, 0.45),
    0 0 25px rgba(124, 92, 255, 0.2);
  background: rgba(20, 28, 46, 0.88);
}

.why-portfolio-card:hover::before {
  opacity: 1;
}

.why-card-shine {
  position: absolute;
  top: 0;
  left: -100%;
  width: 60%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.06),
    transparent
  );
  pointer-events: none;
}

.why-portfolio-card:hover .why-card-shine {
  animation: shine 0.8s ease forwards;
}

.why-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
}

.why-card-icon {
  width: 46px;
  height: 46px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.2rem;
  transition: all 0.4s var(--ease);
  position: relative;
}

.icon-glow-purple {
  background: rgba(124, 92, 255, 0.12);
  border: 1px solid rgba(124, 92, 255, 0.3);
  color: #9d7bff;
  box-shadow: 0 0 16px rgba(124, 92, 255, 0.15);
}
.icon-glow-cyan {
  background: rgba(0, 212, 255, 0.12);
  border: 1px solid rgba(0, 212, 255, 0.3);
  color: #00d4ff;
  box-shadow: 0 0 16px rgba(0, 212, 255, 0.15);
}
.icon-glow-green {
  background: rgba(0, 255, 163, 0.12);
  border: 1px solid rgba(0, 255, 163, 0.3);
  color: #00ffa3;
  box-shadow: 0 0 16px rgba(0, 255, 163, 0.15);
}
.icon-glow-amber {
  background: rgba(255, 184, 0, 0.12);
  border: 1px solid rgba(255, 184, 0, 0.3);
  color: #ffb800;
  box-shadow: 0 0 16px rgba(255, 184, 0, 0.15);
}

.why-portfolio-card:hover .why-card-icon {
  transform: scale(1.08) rotate(3deg);
}

.why-card-num {
  font-family: var(--font-heading);
  font-size: 0.8rem;
  font-weight: 800;
  color: var(--muted);
  opacity: 0.5;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  padding: 3px 10px;
  border-radius: var(--radius-full);
  transition: var(--transition);
}

.why-portfolio-card:hover .why-card-num {
  opacity: 1;
  color: var(--accent);
  border-color: rgba(124, 92, 255, 0.4);
  background: rgba(124, 92, 255, 0.12);
}

.why-portfolio-card h3 {
  font-family: var(--font-heading);
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 8px;
  letter-spacing: 0.2px;
}

.why-portfolio-card p {
  color: var(--muted);
  font-size: 0.86rem;
  line-height: 1.55;
  margin-bottom: 16px;
  flex-grow: 1;
}

.why-card-badge {
  align-self: flex-start;
  font-size: 0.72rem;
  font-weight: 700;
  padding: 4px 12px;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  color: var(--text);
  transition: var(--transition);
}

.why-portfolio-card:hover .why-card-badge {
  background: rgba(124, 92, 255, 0.15);
  border-color: var(--accent);
  color: #fff;
}

/* ============================================================
   6. TEMPLATE SHOWCASE
   ============================================================ */
.templates-section {
  background: var(--bg);
}
.templates-section .container {
  max-width: 1440px;
  width: 100%;
}

/* Currency Switcher */
.currency-toggle-wrapper {
  display: flex;
  position: relative;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  margin-top: 24px;
}
.currency-tip {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 3px;
  width: min(300px, calc(100vw - 40px));
  max-height: 0;
  margin: 0;
  padding: 0 38px 0 16px;
  overflow: hidden;
  visibility: hidden;
  opacity: 0;
  transform: translateY(8px);
  color: var(--text);
  background: rgba(16, 22, 36, 0.96);
  border: 1px solid rgba(0, 212, 255, 0.32);
  border-radius: 12px;
  box-shadow:
    0 8px 28px rgba(0, 0, 0, 0.32),
    0 0 20px rgba(0, 212, 255, 0.1);
  transition:
    max-height 300ms ease-in-out,
    margin 300ms ease-in-out,
    padding 300ms ease-in-out,
    opacity 300ms ease-in-out,
    transform 300ms ease-in-out,
    visibility 0s linear 300ms;
}
.currency-tip.is-visible {
  max-height: 100px;
  margin-bottom: 8px;
  padding-top: 12px;
  padding-bottom: 12px;
  overflow: visible;
  visibility: visible;
  opacity: 1;
  transform: translateY(0);
  transition-delay: 0s;
}
.currency-tip::after {
  position: absolute;
  bottom: -8px;
  left: 50%;
  width: 14px;
  height: 14px;
  content: "";
  background: rgba(16, 22, 36, 0.96);
  border-right: 1px solid rgba(0, 212, 255, 0.32);
  border-bottom: 1px solid rgba(0, 212, 255, 0.32);
  transform: translateX(-50%) rotate(45deg);
}
.currency-tip strong {
  color: #ffffff;
  font-size: 0.9rem;
  font-weight: 700;
  line-height: 1.35;
}
.currency-tip span {
  color: var(--muted);
  font-size: 0.8rem;
  line-height: 1.4;
}
.currency-tip-close {
  position: absolute;
  top: 5px;
  right: 7px;
  display: inline-flex;
  width: 26px;
  height: 26px;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  background: transparent;
  border: 0;
  border-radius: 50%;
  font-size: 1.15rem;
  cursor: pointer;
  transition:
    color 180ms ease,
    background 180ms ease;
}
.currency-tip-close:hover {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.08);
}
.currency-toggle {
  display: inline-flex;
  align-items: center;
  position: relative;
  isolation: isolate;
  width: min(100%, 264px);
  background: var(--glass-bg);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-full);
  padding: 4px;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow: var(--shadow-card);
}
.currency-toggle::before {
  content: "";
  position: absolute;
  z-index: 0;
  top: 4px;
  bottom: 4px;
  left: 4px;
  width: calc((100% - 8px) / 2);
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, #286cff, #00b4d8);
  box-shadow: 0 3px 14px rgba(43, 127, 255, 0.32);
  transform: translateX(var(--currency-slider-offset, 0%));
  transition: transform 260ms cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: none;
}
.currency-btn {
  display: inline-flex;
  position: relative;
  z-index: 1;
  flex: 1 1 50%;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-width: 0;
  min-height: 40px;
  padding: 8px 16px;
  border-radius: var(--radius-full);
  background: transparent;
  border: none;
  color: var(--currency-button-color, var(--muted));
  font-family: var(--font-body);
  font-size: 0.92rem;
  font-weight: 600;
  cursor: pointer;
  transition: color 220ms ease-in-out;
  user-select: none;
}
.currency-btn:hover {
  color: #ffffff;
}
.currency-btn.active {
  color: #ffffff;
  cursor: default;
}
.currency-btn:focus-visible {
  outline: 2px solid var(--accent2);
  outline-offset: 2px;
}
.currency-flag {
  font-size: 1.1rem;
  font-weight: 700;
  line-height: 1;
  display: inline-flex;
  align-items: center;
}
@media (prefers-reduced-motion: reduce) {
  .currency-toggle::before,
  .currency-btn {
    transition-duration: 0.01ms;
  }
}

/* Controls */
.templates-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 32px;
  flex-wrap: wrap;
}
.filter-pills {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}
.filter-pill {
  padding: 8px 20px;
  border-radius: var(--radius-full);
  background: transparent;
  border: 1px solid var(--glass-border);
  color: var(--muted);
  font-size: 0.9rem;
  font-weight: 500;
  cursor: pointer;
  transition: var(--transition);
  font-family: var(--font-body);
}
.filter-pill:hover {
  border-color: var(--accent);
  color: var(--text);
}
.filter-pill.active {
  background: var(--gradient-accent);
  border-color: transparent;
  color: var(--text);
}

.search-box {
  position: relative;
  min-width: 250px;
}
.search-icon {
  position: absolute;
  left: 16px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--muted);
  font-size: 0.9rem;
}
.search-input {
  width: 100%;
  padding: 10px 16px 10px 42px;
  border-radius: var(--radius-full);
  background: var(--glass-bg);
  border: 1px solid var(--glass-border);
  color: var(--text);
  font-size: 0.9rem;
  font-family: var(--font-body);
  transition: var(--transition);
}
.search-input::placeholder {
  color: var(--muted);
}
.search-input:focus {
  outline: none;
  border-color: var(--accent);
  background: rgba(16, 22, 36, 0.9);
}

/* Template Grid */
.templates-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
  align-items: stretch;
}

/* Template Card */
.template-card {
  background: var(--glass-bg);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius);
  padding: 18px 20px;
  position: relative;
  overflow: hidden;
  transition: var(--transition);
  transform-style: preserve-3d;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 100%;
}
.template-card:hover {
  border-color: var(--glass-border-hover);
  transform: translateY(-6px);
  box-shadow: var(--shadow-glow), var(--shadow-card);
}
.card-shine {
  position: absolute;
  top: 0;
  left: -100%;
  width: 60%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.04),
    transparent
  );
  transition: none;
  pointer-events: none;
}
.template-card:hover .card-shine {
  animation: shine 0.8s ease forwards;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}
.template-number {
  font-family: var(--font-heading);
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--accent);
  background: rgba(124, 92, 255, 0.12);
  border: 1px solid rgba(124, 92, 255, 0.25);
  padding: 3px 12px;
  border-radius: var(--radius-full);
  line-height: 1.2;
}
.template-discount-badge {
  font-family: var(--font-heading);
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--accent3);
  background: rgba(0, 255, 163, 0.12);
  border: 1px solid rgba(0, 255, 163, 0.3);
  padding: 3px 12px;
  border-radius: var(--radius-full);
  line-height: 1.2;
}

.template-preview-wrapper {
  width: 100%;
  aspect-ratio: 2 / 1;
  border-radius: 10px;
  overflow: hidden;
  background: #080a12;
  border: 1px solid rgba(255, 255, 255, 0.08);
  position: relative;
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.template-preview-img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
  display: block;
  border-radius: 10px;
  transition: transform 0.4s var(--ease);
}
.template-card:hover .template-preview-img {
  transform: scale(1.03);
}

.card-body {
  margin-bottom: 14px;
  flex: 1;
  display: flex;
  flex-direction: column;
}
.template-title-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 10px;
  margin-bottom: 4px;
}
.template-name {
  font-family: var(--font-heading);
  font-size: 1.35rem;
  font-weight: 800;
  color: var(--text);
  letter-spacing: 0.5px;
  margin: 0;
  line-height: 1.2;
}
.template-price-box {
  display: flex;
  align-items: baseline;
  gap: 6px;
  flex-shrink: 0;
}
.template-old-price {
  font-family: var(--font-heading);
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--muted);
  text-decoration: line-through;
  opacity: 0.75;
}
.template-price {
  font-family: var(--font-heading);
  font-size: 1.25rem;
  font-weight: 800;
  color: var(--accent3);
}
.template-profession {
  color: var(--accent2);
  font-size: 0.88rem;
  font-weight: 600;
  margin-bottom: 3px;
  line-height: 1.25;
}
.template-style {
  font-size: 0.8rem;
  color: var(--muted);
  margin-bottom: 10px;
  line-height: 1.35;
}
.template-features {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
  margin-top: auto;
}
.feature-chip {
  display: inline-block;
  padding: 3px 10px;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.06);
  font-size: 0.72rem;
  color: var(--muted);
  font-weight: 500;
  line-height: 1.3;
}

.card-footer {
  display: flex;
  gap: 8px;
}
.btn-preview,
.btn-details {
  flex: 1;
  padding: 9px 12px;
  border-radius: var(--radius-sm);
  font-weight: 600;
  font-size: 0.82rem;
  text-align: center;
  transition: var(--transition);
  cursor: pointer;
  text-decoration: none;
  display: inline-block;
}
.btn-preview {
  background: var(--gradient-accent);
  color: var(--text);
  border: none;
}
.btn-preview:hover {
  box-shadow: 0 4px 15px rgba(124, 92, 255, 0.4);
  transform: translateY(-2px);
}
.btn-details {
  background: transparent;
  color: var(--text);
  border: 1px solid var(--glass-border);
  font-family: var(--font-body);
}
.btn-details:hover {
  border-color: var(--accent);
  background: rgba(124, 92, 255, 0.08);
}

.btn-make-yours {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  margin-top: 8px;
  padding: 9px 14px;
  border-radius: var(--radius-sm);
  background: linear-gradient(135deg, #25d366, #1eae53);
  color: #ffffff;
  font-weight: 600;
  font-size: 0.86rem;
  text-decoration: none;
  transition: var(--transition);
  box-shadow: 0 4px 15px rgba(37, 211, 102, 0.25);
}
.btn-make-yours:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(37, 211, 102, 0.45);
  color: #ffffff;
}
.btn-make-yours i {
  font-size: 1rem;
}

.template-download-section {
  margin: 56px auto 0;
}
.template-download-section .section-header {
  margin-bottom: 32px;
}
.template-download-card {
  max-width: 720px;
  margin: 0 auto;
  min-height: 0;
  padding: 28px;
}
.template-download-card .card-body {
  text-align: center;
}
.template-download-card .template-name {
  margin-bottom: 8px;
}
.template-download-card .template-profession {
  margin-bottom: 10px;
}
.template-download-card .template-style {
  font-size: 0.9rem;
  line-height: 1.6;
  margin-bottom: 0;
}
.template-download-actions a {
  flex: 1;
  padding: 12px 16px;
  font-size: 0.9rem;
}
.template-download-actions .btn-details {
  display: inline-block;
}

/* ============================================================
   7. PRICING SECTION
   ============================================================ */
.pricing-section {
  background: var(--bg-secondary);
}
.pricing-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
  align-items: start;
}
.pricing-card {
  background: var(--glass-bg);
  backdrop-filter: blur(20px);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius);
  padding: 36px 28px;
  position: relative;
  transition: var(--transition);
  display: flex;
  flex-direction: column;
}
.pricing-card:hover {
  transform: translateY(-8px);
  border-color: var(--glass-border-hover);
  box-shadow: var(--shadow-glow);
}
.pricing-card.popular {
  border-color: var(--accent);
  transform: scale(1.05);
  box-shadow: var(--shadow-glow);
}
.pricing-card.popular:hover {
  transform: scale(1.05) translateY(-8px);
}
.popular-badge {
  position: absolute;
  top: -1px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--gradient-accent);
  color: var(--text);
  padding: 4px 20px;
  border-radius: 0 0 var(--radius-sm) var(--radius-sm);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 1px;
}
.plan-name {
  font-size: 1.2rem;
  font-weight: 700;
  margin-bottom: 8px;
  color: var(--text);
}
.plan-price {
  font-family: var(--font-heading);
  font-size: 2.2rem;
  font-weight: 800;
  margin-bottom: 8px;
  background: var(--gradient-accent);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.plan-desc {
  font-size: 0.9rem;
  color: var(--muted);
  margin-bottom: 24px;
}
.plan-features {
  list-style: none;
  margin-bottom: 28px;
  flex-grow: 1;
}
.plan-features li {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 0;
  color: var(--muted);
  font-size: 0.9rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.03);
}
.plan-features li:last-child {
  border-bottom: none;
}
.check-icon {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
  color: var(--accent3);
}
.pricing-card .btn {
  width: 100%;
  justify-content: center;
  margin-top: auto;
}

/* ============================================================
   8. CUSTOMIZATION SECTION
   ============================================================ */
.customization-section {
  background: var(--bg);
  position: relative;
}
.custom-wrapper {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
}
.custom-content {
}
.custom-text {
  font-size: 1.05rem;
  color: var(--muted);
  margin-bottom: 32px;
  line-height: 1.8;
}
.custom-content .btn {
  padding: 12px 24px;
  font-size: 0.9rem;
}
.custom-features {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}
.custom-feature-card {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 20px;
  background: var(--glass-bg);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius);
  transition: var(--transition);
}
.custom-feature-card:hover {
  border-color: var(--glass-border-hover);
  transform: translateY(-4px);
  box-shadow: var(--shadow-glow);
}
.feature-icon {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  background: rgba(124, 92, 255, 0.1);
  color: var(--accent);
  font-size: 1.1rem;
  flex-shrink: 0;
}
.feature-info h4 {
  font-size: 1rem;
  font-weight: 600;
  margin-bottom: 4px;
  color: var(--text);
}
.feature-info p {
  font-size: 0.85rem;
  color: var(--muted);
  margin: 0;
  line-height: 1.5;
}

/* ============================================================
   8.5. WORKFLOW SECTION
   ============================================================ */
.workflow-section {
  background: var(--bg-secondary);
  position: relative;
}
.workflow-timeline {
  position: relative;
  max-width: 900px;
  margin: 0 auto;
  padding: 40px 0;
}
.workflow-line {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 50%;
  width: 3px;
  background: rgba(255, 255, 255, 0.08);
  transform: translateX(-50%);
  z-index: 1;
  border-radius: 3px;
}
.workflow-progress-line {
  position: absolute;
  top: 0;
  left: 50%;
  width: 3px;
  height: 0%;
  background: linear-gradient(
    to bottom,
    var(--accent),
    var(--accent2),
    var(--accent3)
  );
  transform: translateX(-50%);
  z-index: 2;
  border-radius: 3px;
  transition: height 0.1s linear;
}
.workflow-step {
  display: grid;
  grid-template-columns: 1fr 60px 1fr;
  align-items: center;
  gap: 30px;
  margin-bottom: 60px;
  position: relative;
  z-index: 3;
}
.workflow-step:last-child {
  margin-bottom: 0;
}
.step-badge {
  width: 50px;
  height: 50px;
  border-radius: 50%;
  background: var(--bg-tertiary);
  color: var(--muted);
  font-family: var(--font-heading);
  font-size: 1.2rem;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  border: 3px solid var(--glass-border);
  transition: all 0.5s cubic-bezier(0.25, 1, 0.5, 1);
}
.workflow-step.active .step-badge {
  background: var(--gradient-accent);
  color: var(--text);
  box-shadow: 0 0 25px rgba(124, 92, 255, 0.6);
  border-color: var(--bg-secondary);
  transform: scale(1.15);
}
.step-content {
  padding: 28px;
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius);
  transition: all 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  opacity: 0.2;
  transform: translateY(30px);
}
.workflow-step.active .step-content {
  opacity: 1;
  transform: translateY(0);
  border-color: var(--glass-border-hover);
  box-shadow: var(--shadow-glow);
}
.step-content:hover {
  border-color: var(--accent);
  transform: translateY(-4px);
}
.step-number-tag {
  display: block;
  font-family: var(--font-heading);
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--accent2);
  margin-bottom: 6px;
}
.step-content h3 {
  font-size: 1.3rem;
  margin-bottom: 8px;
  color: var(--text);
}
.step-content p {
  font-size: 0.9rem;
  color: var(--muted);
  margin: 0;
  line-height: 1.6;
}
.text-right {
  text-align: right;
}
.text-left {
  text-align: left;
}
.step-empty {
}

@media (max-width: 768px) {
  .workflow-timeline {
    padding: 20px 0;
  }
  .workflow-line,
  .workflow-progress-line {
    left: 25px;
  }
  .workflow-step {
    grid-template-columns: 50px 1fr;
    gap: 20px;
    margin-bottom: 40px;
  }
  .step-empty {
    display: none;
  }
  .text-right {
    text-align: left;
  }
  .workflow-step .step-badge {
    order: 1;
    margin: 0;
  }
  .workflow-step .step-content {
    order: 2;
  }
}

/* ============================================================
   9. ABOUT / STATS SECTION
   ============================================================ */
/* ============================================================
   9. ABOUT / STATS SECTION (ULTRA PREMIUM)
   ============================================================ */
.about-section {
  background: var(--bg-secondary);
  position: relative;
  overflow: hidden;
}

.about-bg-glow {
  position: absolute;
  top: 40%;
  right: 10%;
  width: 500px;
  height: 500px;
  background: radial-gradient(
    circle,
    rgba(124, 92, 255, 0.12) 0%,
    rgba(0, 212, 255, 0.05) 50%,
    transparent 70%
  );
  filter: blur(80px);
  pointer-events: none;
  z-index: 0;
}

.about-grid {
  display: grid;
  grid-template-columns: 1fr 1.1fr;
  gap: 60px;
  align-items: center;
  position: relative;
  z-index: 1;
}

.about-content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.about-content .section-tag {
  align-self: flex-start;
  margin-bottom: 20px;
}

.about-content .btn {
  align-self: flex-start;
}

.about-description {
  font-size: 1.05rem;
  color: var(--muted);
  line-height: 1.8;
  margin-bottom: 28px;
}

.about-highlights {
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin-bottom: 36px;
}

.about-highlight-item {
  display: flex;
  align-items: center;
  gap: 14px;
  font-size: 0.95rem;
  font-weight: 500;
  color: var(--text);
}

.highlight-icon {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  background: rgba(0, 255, 163, 0.12);
  border: 1px solid rgba(0, 255, 163, 0.3);
  color: var(--accent3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.75rem;
  flex-shrink: 0;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
}

.stat-card {
  background: rgba(16, 22, 36, 0.75);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: var(--radius);
  padding: 24px 20px 20px;
  transition: all 0.4s var(--ease);
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transform-style: preserve-3d;
}

.stat-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: var(--gradient-accent);
  opacity: 0;
  transition: opacity 0.4s ease;
}

.stat-card:hover {
  border-color: rgba(124, 92, 255, 0.4);
  transform: translateY(-6px) scale(1.02);
  box-shadow:
    0 16px 30px rgba(0, 0, 0, 0.45),
    0 0 25px rgba(124, 92, 255, 0.2);
  background: rgba(20, 28, 46, 0.88);
}

.stat-card:hover::before {
  opacity: 1;
}

.stat-card-shine {
  position: absolute;
  top: 0;
  left: -100%;
  width: 60%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.06),
    transparent
  );
  pointer-events: none;
}

.stat-card:hover .stat-card-shine {
  animation: shine 0.8s ease forwards;
}

.stat-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
}

.stat-icon {
  width: 46px;
  height: 46px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.25rem;
  margin-bottom: 0;
  transition: all 0.4s var(--ease);
}

.stat-card:hover .stat-icon {
  transform: scale(1.1) rotate(4deg);
}

.stat-badge {
  font-family: var(--font-heading);
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--muted);
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  padding: 3px 10px;
  border-radius: var(--radius-full);
}

.stat-number-wrapper {
  display: flex;
  align-items: baseline;
  margin-bottom: 4px;
}

.stat-number {
  font-family: var(--font-heading);
  font-size: 2.8rem;
  font-weight: 800;
  background: var(--gradient-accent);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  line-height: 1;
}

.stat-suffix {
  font-family: var(--font-heading);
  font-size: 1.8rem;
  font-weight: 800;
  background: var(--gradient-accent);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-left: 2px;
}

.stat-label {
  font-size: 0.88rem;
  color: var(--muted);
  font-weight: 500;
  margin-top: 0;
}

/* ============================================================
   10. WHY CHOOSE CODE5IN
   ============================================================ */
.why-section {
  background: var(--bg);
}
.why-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
.why-card {
  padding: 36px 28px;
  background: var(--glass-bg);
  backdrop-filter: blur(20px);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius);
  transition: var(--transition);
  text-align: center;
}
.why-card:hover {
  border-color: var(--glass-border-hover);
  transform: translateY(-6px);
  box-shadow: var(--shadow-glow);
}
.why-icon {
  width: 64px;
  height: 64px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16px;
  background: rgba(124, 92, 255, 0.1);
  color: var(--accent);
  font-size: 1.5rem;
  margin: 0 auto 20px;
}
.why-card h3 {
  font-size: 1.2rem;
  margin-bottom: 10px;
}
.why-card p {
  font-size: 0.9rem;
  color: var(--muted);
  margin: 0;
  line-height: 1.6;
}

/* ============================================================
   11. TESTIMONIALS
   ============================================================ */
.testimonials-section {
  background: var(--bg-secondary);
  overflow: hidden;
}
.testimonials-carousel {
  overflow: hidden;
  margin: 0 -24px;
  padding: 0 24px;
}
.testimonials-track {
  display: flex;
  gap: 24px;
  will-change: transform;
}
.testimonial-card {
  min-width: 380px;
  max-width: 380px;
  padding: 32px;
  background: var(--glass-bg);
  backdrop-filter: blur(20px);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius);
  flex-shrink: 0;
  transition: var(--transition);
}
.testimonial-card:hover {
  border-color: var(--glass-border-hover);
}
.testimonial-quote {
  font-size: 2rem;
  color: var(--accent);
  margin-bottom: 12px;
  line-height: 1;
}
.testimonial-rating {
  margin-bottom: 16px;
}
.testimonial-rating .stars {
  color: #ffd700;
  font-size: 1rem;
  letter-spacing: 2px;
}
.testimonial-text {
  font-size: 1rem;
  color: var(--muted);
  line-height: 1.7;
  margin-bottom: 20px;
  font-style: italic;
}
.testimonial-author {
  display: flex;
  align-items: center;
  gap: 12px;
}
.testimonial-avatar {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: var(--gradient-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--text);
  flex-shrink: 0;
}
.author-info h4 {
  font-size: 1rem;
  font-weight: 600;
  margin-bottom: 2px;
}
.author-info span {
  font-size: 0.85rem;
  color: var(--muted);
}

/* ============================================================
   12. FAQ SECTION
   ============================================================ */
.faq-section {
  background: var(--bg);
}
.faq-list {
  max-width: 800px;
  margin: 0 auto;
}
.faq-item {
  margin-bottom: 12px;
  border-radius: var(--radius);
  overflow: hidden;
}
.faq-header {
  width: 100%;
  padding: 20px 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
  background: var(--glass-bg);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius);
  transition: var(--transition);
  color: var(--text);
  font-family: var(--font-body);
  font-size: 1.05rem;
  font-weight: 500;
  text-align: left;
}
.faq-header:hover {
  border-color: rgba(124, 92, 255, 0.2);
}
.faq-question {
  flex: 1;
}
.faq-icon {
  font-size: 1.4rem;
  color: var(--accent);
  flex-shrink: 0;
  transition: var(--transition);
  font-weight: 300;
  width: 24px;
  text-align: center;
}
.faq-item.active .faq-header {
  border-color: var(--accent);
  background: rgba(124, 92, 255, 0.05);
  border-radius: var(--radius) var(--radius) 0 0;
}
.faq-content {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.4s ease;
  background: rgba(16, 22, 36, 0.4);
  border-left: 1px solid var(--accent);
  border-right: 1px solid var(--glass-border);
  border-bottom: 1px solid var(--glass-border);
  border-radius: 0 0 var(--radius) var(--radius);
}
.faq-content p {
  padding: 20px 24px;
  margin: 0;
  line-height: 1.7;
}

/* ============================================================
   13. CONTACT SECTION
   ============================================================ */
.contact-section {
  background: var(--bg-secondary);
}
.contact-wrapper {
  display: grid;
  grid-template-columns: 1fr 1.5fr;
  gap: 50px;
  align-items: start;
}
.contact-info {
  display: flex;
  flex-direction: column;
  gap: 24px;
}
.contact-info-card {
  display: flex;
  align-items: center;
  gap: 20px;
  padding: 24px;
  background: var(--glass-bg);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius);
  transition: var(--transition);
}
.contact-info-card:hover {
  border-color: var(--glass-border-hover);
  transform: translateX(6px);
}
.contact-icon {
  width: 50px;
  height: 50px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  background: rgba(124, 92, 255, 0.1);
  color: var(--accent);
  font-size: 1.2rem;
  flex-shrink: 0;
}
.contact-details h4 {
  font-size: 1rem;
  font-weight: 600;
  margin-bottom: 4px;
}
.contact-details a,
.contact-details p {
  color: var(--muted);
  font-size: 0.95rem;
  margin: 0;
}
.contact-details a:hover {
  color: var(--accent2);
}
.contact-social {
  display: flex;
  gap: 12px;
  margin-top: 12px;
}
.social-link {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--glass-border);
  color: var(--muted);
  font-size: 1rem;
  transition: var(--transition);
}
.social-link:hover {
  background: var(--accent);
  border-color: var(--accent);
  color: var(--text);
  transform: translateY(-3px);
}

/* Contact Form */
.contact-form-wrapper {
  position: relative;
}
.contact-form {
  padding: 40px;
  background: var(--glass-bg);
  backdrop-filter: blur(20px);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius);
}
.form-group {
  margin-bottom: 20px;
}
.form-group label {
  display: block;
  font-size: 0.9rem;
  font-weight: 500;
  color: var(--text);
  margin-bottom: 8px;
}
.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}
.contact-form input,
.contact-form textarea {
  width: 100%;
  padding: 14px 18px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm);
  color: var(--text);
  font-size: 0.95rem;
  font-family: var(--font-body);
  transition: var(--transition);
}
.contact-form input::placeholder,
.contact-form textarea::placeholder {
  color: rgba(160, 168, 192, 0.5);
}
.contact-form input:focus,
.contact-form textarea:focus {
  outline: none;
  border-color: var(--accent);
  background: rgba(255, 255, 255, 0.05);
  box-shadow: 0 0 0 3px rgba(124, 92, 255, 0.1);
}
.contact-form textarea {
  resize: vertical;
  min-height: 120px;
}

.btn-submit {
  width: 100%;
  justify-content: center;
  position: relative;
}
.btn-submit .btn-loading {
  display: none;
}
.btn-submit.loading .btn-text {
  display: none;
}
.btn-submit.loading .btn-icon {
  display: none;
}
.btn-submit.loading .btn-loading {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

/* Form Success */
.form-success {
  display: none;
  text-align: center;
  padding: 60px 40px;
  background: var(--glass-bg);
  backdrop-filter: blur(20px);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius);
}
.form-success.show {
  display: block;
}
.form-success h3 {
  font-size: 1.5rem;
  margin-bottom: 12px;
  color: var(--accent3);
}
.form-success p {
  color: var(--muted);
  margin-bottom: 24px;
}

/* Checkmark Animation */
.success-checkmark {
  width: 80px;
  height: 80px;
  margin: 0 auto 24px;
  position: relative;
}
.check-icon {
  width: 80px;
  height: 80px;
  position: relative;
  border-radius: 50%;
  box-sizing: content-box;
  border: 4px solid var(--accent3);
}
.icon-line {
  height: 5px;
  background-color: var(--accent3);
  display: block;
  border-radius: 2px;
  position: absolute;
  z-index: 10;
}
.line-tip {
  top: 46px;
  left: 14px;
  width: 25px;
  transform: rotate(45deg);
  animation: icon-line-tip 0.75s;
}
.line-long {
  top: 38px;
  right: 8px;
  width: 47px;
  transform: rotate(-45deg);
  animation: icon-line-long 0.75s;
}
@keyframes icon-line-tip {
  0% {
    width: 0;
    left: 1px;
    top: 19px;
  }
  54% {
    width: 0;
    left: 1px;
    top: 19px;
  }
  70% {
    width: 50px;
    left: -8px;
    top: 37px;
  }
  84% {
    width: 17px;
    left: 21px;
    top: 48px;
  }
  100% {
    width: 25px;
    left: 14px;
    top: 46px;
  }
}
@keyframes icon-line-long {
  0% {
    width: 0;
    right: 46px;
    top: 54px;
  }
  65% {
    width: 0;
    right: 46px;
    top: 54px;
  }
  84% {
    width: 55px;
    right: 0;
    top: 35px;
  }
  100% {
    width: 47px;
    right: 8px;
    top: 38px;
  }
}

/* ============================================================
   14. FOOTER
   ============================================================ */
.footer {
  background: var(--bg);
  padding: 80px 0 0;
  position: relative;
  border-top: 1px solid var(--glass-border);
}
.footer::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 2px;
  background: var(--gradient-multi);
}
.footer-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1.5fr;
  gap: 40px;
  padding-bottom: 60px;
}
.footer-logo {
  font-family: var(--font-heading);
  font-size: 1.6rem;
  font-weight: 800;
  display: inline-block;
  margin-bottom: 16px;
}
.footer-description {
  font-size: 0.95rem;
  color: var(--muted);
  line-height: 1.7;
  margin-bottom: 20px;
}
.footer-social {
  display: flex;
  gap: 10px;
}
.footer-links-col h4 {
  font-size: 1.1rem;
  font-weight: 600;
  margin-bottom: 20px;
  color: var(--text);
}
.footer-links-col ul {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.footer-links-col a {
  color: var(--muted);
  font-size: 0.9rem;
  transition: var(--transition);
}
.footer-links-col a:hover {
  color: var(--accent2);
  padding-left: 4px;
}
.footer-contact-list li {
  display: flex;
  align-items: center;
  gap: 10px;
}
.footer-contact-list i {
  color: var(--accent);
  font-size: 0.85rem;
}
.footer-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24px 0;
  border-top: 1px solid var(--glass-border);
}
.footer-bottom p {
  font-size: 0.85rem;
  color: var(--muted);
  margin: 0;
}

/* ============================================================
   15. TEMPLATE MODAL
   ============================================================ */
.template-modal {
  position: fixed;
  inset: 0;
  z-index: 99999;
  display: none;
  align-items: center;
  justify-content: center;
}
.template-modal.active {
  display: flex;
}
.modal-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(8px);
}
.modal-content {
  position: relative;
  z-index: 1;
  width: 90%;
  max-width: 600px;
  max-height: 85vh;
  overflow-y: auto;
  background: var(--bg-secondary);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius);
  padding: 40px;
}
.modal-close {
  position: absolute;
  top: 16px;
  right: 16px;
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--glass-border);
  color: var(--text);
  font-size: 1.4rem;
  cursor: pointer;
  transition: var(--transition);
}
.modal-close:hover {
  background: rgba(255, 255, 255, 0.1);
}
.modal-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}
.modal-template-number {
  color: var(--accent);
  font-size: 0.9rem;
  font-weight: 700;
  margin-bottom: 0;
  background: rgba(124, 92, 255, 0.12);
  border: 1px solid rgba(124, 92, 255, 0.25);
  padding: 4px 14px;
  border-radius: var(--radius-full);
}
.modal-discount-badge {
  font-family: var(--font-heading);
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--accent3);
  background: rgba(0, 255, 163, 0.12);
  border: 1px solid rgba(0, 255, 163, 0.3);
  padding: 4px 14px;
  border-radius: var(--radius-full);
}
.modal-preview-wrapper {
  width: 100%;
  aspect-ratio: 16 / 9;
  border-radius: var(--radius-sm);
  overflow: hidden;
  background: #0c101c;
  border: 1px solid var(--glass-border);
  margin-bottom: 20px;
}
.modal-preview-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
  display: block;
}
.modal-template-name {
  font-size: 2rem;
  font-weight: 800;
  margin-bottom: 6px;
}
.modal-template-profession {
  color: var(--accent2);
  font-size: 1.1rem;
  margin-bottom: 20px;
}
.modal-template-style {
  color: var(--muted);
  font-size: 0.95rem;
  margin-bottom: 24px;
}
.modal-features-title {
  font-size: 1rem;
  margin-bottom: 12px;
}
.modal-features-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 28px;
}
.modal-feature-chip {
  padding: 6px 16px;
  border-radius: var(--radius-full);
  background: rgba(124, 92, 255, 0.1);
  border: 1px solid rgba(124, 92, 255, 0.2);
  color: var(--accent);
  font-size: 0.85rem;
  font-weight: 500;
}
.modal-price-box {
  display: flex;
  align-items: baseline;
  gap: 12px;
  margin-bottom: 24px;
}
.modal-old-price {
  font-family: var(--font-heading);
  font-size: 1.3rem;
  font-weight: 600;
  color: var(--muted);
  text-decoration: line-through;
  opacity: 0.7;
}
.modal-price {
  font-family: var(--font-heading);
  font-size: 2rem;
  font-weight: 800;
  background: var(--gradient-accent);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.modal-buttons {
  display: flex;
  gap: 12px;
}
.modal-buttons .btn {
  flex: 1;
  justify-content: center;
}

/* ============================================================
   16. FLOATING ELEMENTS
   ============================================================ */
/* WhatsApp */
.whatsapp-float {
  position: fixed;
  bottom: 28px;
  right: 28px;
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: #25d366;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.8rem;
  z-index: 9990;
  box-shadow: 0 4px 16px rgba(37, 211, 102, 0.4);
  transition: transform 0.3s ease;
  animation: pulse 2s infinite;
}
.whatsapp-float:hover {
  transform: scale(1.1);
  color: white;
}

/* Back to Top */
.back-to-top {
  position: fixed;
  bottom: 28px;
  left: 28px;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: var(--glass-bg);
  border: 1px solid var(--glass-border);
  color: var(--text);
  font-size: 1.1rem;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9990;
  opacity: 0;
  visibility: hidden;
  transform: translateY(20px);
  transition: var(--transition);
  cursor: pointer;
  backdrop-filter: blur(10px);
}
.back-to-top.visible {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}
.back-to-top:hover {
  background: var(--accent);
  border-color: var(--accent);
}

/* ============================================================
   17. RESPONSIVE DESIGN
   ============================================================ */

/* Ultra Wide */
@media (min-width: 1600px) {
  :root {
    --container: 1400px;
  }
  .hero-headline {
    font-size: 6rem;
  }
}

/* Tablet */
@media (max-width: 1024px) {
  :root {
    --section-py: 80px;
  }

  .nav-links {
    position: fixed;
    top: 0;
    right: -100%;
    width: 290px;
    height: 100vh;
    background: rgba(12, 16, 28, 0.98);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: 60px 36px;
    gap: 8px;
    transition: right 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    border-left: 1px solid var(--glass-border);
    z-index: 99995;
    box-shadow: -10px 0 40px rgba(0, 0, 0, 0.7);
  }
  .nav-links.active {
    right: 0 !important;
  }
  .mobile-nav-header {
    display: block;
    width: 100%;
    margin-bottom: 16px;
  }
  .mobile-nav-tag {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--accent2);
    opacity: 0.9;
  }
  .nav-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent);
    background: rgba(124, 92, 255, 0.12);
    padding: 3px 9px;
    border-radius: var(--radius-full);
    margin-right: 12px;
    border: 1px solid rgba(124, 92, 255, 0.2);
  }
  .nav-link {
    font-size: 1.15rem;
    font-weight: 600;
    padding: 14px 0;
    width: 100%;
    color: var(--muted);
    text-align: left;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
  }
  .nav-link:last-child {
    border-bottom: none;
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--text);
    padding-left: 10px;
  }
  .nav-link:hover .nav-num,
  .nav-link.active .nav-num {
    background: var(--accent);
    color: var(--text);
    border-color: var(--accent);
  }
  .mobile-nav-cta-wrapper {
    display: block;
    width: 100%;
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .mobile-nav-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 14px 20px;
    border-radius: var(--radius-full);
    background: var(--gradient-accent);
    color: var(--text);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 4px 20px rgba(124, 92, 255, 0.35);
    transition: var(--transition);
  }
  .mobile-nav-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 25px rgba(0, 212, 255, 0.5);
  }
  .nav-cta {
    display: none;
  }
  .nav-toggle {
    display: flex;
  }

  .why-portfolio-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .templates-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .pricing-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .pricing-card.popular {
    transform: scale(1);
  }
  .pricing-card.popular:hover {
    transform: translateY(-8px);
  }
  .about-grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .custom-wrapper {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .why-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .contact-wrapper {
    grid-template-columns: 1fr;
  }
  .footer-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* Mobile */
@media (max-width: 768px) {
  :root {
    --section-py: 60px;
  }

  .hero {
    padding: 90px 20px 50px;
  }
  .hero-badge {
    margin-bottom: 22px;
    font-size: 0.9rem;
    padding: 6px 18px;
  }
  .hero-headline {
    font-size: clamp(3.2rem, 12vw, 4.6rem);
    line-height: 1.05;
    margin-bottom: 24px;
    font-weight: 900;
    letter-spacing: -0.5px;
  }
  .hero-subheading {
    font-size: 1.1rem;
    line-height: 1.65;
    margin-bottom: 32px;
    max-width: 100%;
  }
  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    max-width: 420px;
    margin: 0 auto 36px;
  }
  .hero-buttons .btn-primary {
    width: 100%;
    justify-content: center;
    padding: 14px 26px;
    font-size: 1.02rem;
  }
  .hero-buttons .btn-secondary {
    flex: 1;
    justify-content: center;
    padding: 14px 22px;
    font-size: 0.95rem;
  }
  .hero-share-btn {
    width: 50px;
    height: 50px;
    flex-shrink: 0;
  }
  .hero-stats {
    gap: 20px;
    margin-top: 12px;
  }
  .hero-stat-number {
    font-size: 1.75rem;
  }
  .hero-stat-label {
    font-size: 0.9rem;
  }
  .hero-stat-divider {
    height: 28px;
  }
  .hero-scroll-indicator {
    display: none;
  }

  .templates-controls {
    flex-direction: column;
    align-items: stretch;
  }
  .filter-pills {
    justify-content: center;
  }
  .search-box {
    min-width: 100%;
  }
  .templates-grid {
    grid-template-columns: 1fr;
  }
  .why-portfolio-grid {
    grid-template-columns: 1fr;
  }
  .template-download-section {
    margin-top: 40px;
  }
  .template-download-card {
    padding: 24px 20px;
  }
  .template-download-actions {
    flex-direction: column;
  }
  .template-download-actions a {
    width: 100%;
  }

  .section-title {
    font-size: 1.8rem;
  }

  .pricing-grid {
    grid-template-columns: 1fr;
    max-width: 400px;
    margin: 0 auto;
  }
  .custom-features {
    grid-template-columns: 1fr;
  }
  .stats-grid {
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .why-grid {
    grid-template-columns: 1fr;
  }

  .testimonial-card {
    min-width: 300px;
    max-width: 300px;
  }

  .form-row {
    grid-template-columns: 1fr;
  }
  .contact-form {
    padding: 24px;
  }

  .footer-grid {
    grid-template-columns: 1fr;
    gap: 30px;
  }
  .footer-bottom {
    flex-direction: column;
    gap: 8px;
    text-align: center;
  }

  .whatsapp-float {
    bottom: 20px;
    right: 20px;
    width: 50px;
    height: 50px;
    font-size: 1.5rem;
  }
  .back-to-top {
    bottom: 20px;
    left: 20px;
    width: 42px;
    height: 42px;
  }

  .modal-content {
    padding: 28px 20px;
  }
}

/* Small Mobile */
@media (max-width: 480px) {
  .stat-card {
    padding: 24px 16px;
  }
  .stat-number {
    font-size: 2.2rem;
  }
  .filter-pill {
    padding: 6px 14px;
    font-size: 0.8rem;
  }
  .currency-btn {
    padding: 6px 12px;
    font-size: 0.82rem;
  }
  .template-card {
    padding: 20px;
  }
}
